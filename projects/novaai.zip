<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEO Rakip Analizi: etutai.com.tr — Manus AI</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#f8fafc;--surface:#ffffff;--ink:#0f172a;--ink2:#475569;
  --brand:#2563eb;--brand-soft:#dbeafe;--accent:#0ea5e9;
  --danger:#dc2626;--success:#16a34a;--warn:#f59e0b;
  --border:#e2e8f0;--card-shadow:0 1px 3px rgba(15,23,42,.08),0 8px 24px rgba(15,23,42,.05);
  --radius:14px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65}
.container{max-width:1120px;margin:0 auto;padding:0 24px}

/* Top bar */
.topbar{background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 100%);color:#fff;padding:14px 0}
.topbar .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.topbar .brand{font-weight:700;font-size:15px;letter-spacing:.3px}
.topbar .meta{font-size:12.5px;opacity:.85}

/* Hero */
.hero{background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 60%,#0ea5e9 100%);color:#fff;padding:56px 0 64px}
.hero h1{font-size:clamp(28px,4.4vw,44px);font-weight:800;letter-spacing:-.5px}
.hero p.lead{max-width:760px;margin-top:14px;font-size:17px;opacity:.92}
.hero .badge{display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:4px 14px;font-size:12.5px;font-weight:600;margin-bottom:16px;backdrop-filter:blur(4px)}
.kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-top:34px}
.kpi{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.25);border-radius:var(--radius);padding:16px 18px;backdrop-filter:blur(4px)}
.kpi .n{font-size:26px;font-weight:800}
.kpi .l{font-size:12.5px;opacity:.85;margin-top:2px}

/* Nav */
.sticky-nav{position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);box-shadow:0 2px 8px rgba(15,23,42,.06)}
.sticky-nav .container{display:flex;gap:4px;overflow-x:auto;padding:8px 24px}
.sticky-nav a{text-decoration:none;color:var(--ink2);font-size:13.5px;font-weight:600;padding:7px 14px;border-radius:8px;white-space:nowrap;transition:all .15s}
.sticky-nav a:hover{background:var(--brand-soft);color:var(--brand)}

/* Sections */
section{padding:48px 0}
section.alt{background:var(--surface)}
h2.sec-title{font-size:24px;font-weight:800;margin-bottom:6px}
h3.sub{font-size:17px;font-weight:700;margin:26px 0 8px;color:var(--ink)}
p.finding{border-left:4px solid var(--brand);padding-left:14px;margin:10px 0 12px;color:var(--ink2);font-size:15px}
p.finding b{color:var(--ink)}

/* Cards & charts */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--card-shadow);padding:22px 24px;margin:18px 0}
.card h4{font-size:14.5px;font-weight:700;margin-bottom:12px;color:var(--ink)}
.chart-wrap{position:relative;max-height:380px}
.chart-wrap canvas{max-height:370px}
.chart-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(380px,1fr));gap:18px}
.stat-figure{width:100%;max-height:440px;border-radius:10px}

/* Tables */
.tbl-wrap{overflow-x:auto;margin:14px 0}
table{width:100%;border-collapse:collapse;font-size:13.5px;background:var(--surface)}
th{background:#f1f5f9;text-align:left;padding:10px 12px;font-size:12.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--ink2);border-bottom:2px solid var(--border)}
td{padding:9px 12px;border-bottom:1px solid var(--border);color:var(--ink)}
tr:hover td{background:#f8fafc}
td.num{font-variant-numeric:tabular-nums;text-align:right}

/* Tags */
.tag{display:inline-block;font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:6px}
.tag.blue{background:var(--brand-soft);color:var(--brand)}
.tag.green{background:#dcfce7;color:var(--success)}
.tag.red{background:#fee2e2;color:var(--danger)}
.tag.amber{background:#fef3c7;color:#b45309}

/* Callouts */
.limit{background:#fffbeb;border:1px solid #fde68a;border-radius:var(--radius);padding:14px 18px;font-size:13.5px;color:#92400e;margin:14px 0}
.limit b{color:#78350f}
.note{background:#f0f9ff;border:1px solid #bae6fd;border-radius:var(--radius);padding:14px 18px;font-size:13.5px;color:#0c4a6e;margin:14px 0}

/* Footer */
footer{background:#0f172a;color:#cbd5e1;padding:34px 0 28px;font-size:13px}
footer h5{color:#fff;font-size:14px;margin-bottom:8px}
footer a{color:#93c5fd;text-decoration:none}
footer ol{padding-left:20px;margin-top:4px}
footer ol li{margin-bottom:3px}
.srcs{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-top:10px}

/* Tabs */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.tab{border:1px solid var(--border);background:var(--surface);padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;color:var(--ink2);transition:all .15s}
.tab.active{background:var(--brand);color:#fff;border-color:var(--brand)}
.tab-panels .panel{display:none}
.tab-panels .panel.active{display:block}

/* Interactive heatmap */
.hm{display:grid;gap:3px;margin:14px 0}
.hm .cell{border-radius:6px;padding:8px 4px;font-size:12px;font-weight:700;color:#fff;text-align:center;cursor:pointer;position:relative;transition:transform .15s}
.hm .cell:hover{transform:scale(1.06);z-index:2}
.hm .cell .tt{display:none;position:absolute;bottom:108%;left:50%;transform:translateX(-50%);background:#0f172a;color:#fff;font-size:11px;font-weight:500;padding:4px 8px;border-radius:6px;white-space:nowrap;z-index:3}
.hm .cell:hover .tt{display:block}
.hm .cell.zero{background:#f1f5f9;color:#94a3b8;cursor:default}
.hm .cell.zero:hover{transform:none}

/* Tooltip overlay for interactive page table */
.hover-row{cursor:pointer}
#pageDetail{display:none;background:#0f172a;color:#e2e8f0;border-radius:var(--radius);padding:14px 18px;margin-top:10px;font-size:13px;line-height:1.7}
#pageDetail b{color:#93c5fd}

@media (max-width:720px){
  .hero{padding:36px 0 44px}
  section{padding:34px 0}
  .chart-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="topbar">
  <div class="container">
    <div class="brand">Manus AI — SEO Rakip Analizi</div>
    <div class="meta">Hedef alan adı: etutai.com.tr &nbsp;·&nbsp; Rapor tarihi: 18 Ağustos 2026</div>
  </div>
</div>

<header class="hero">
  <div class="container">
    <span class="badge">Eğitim Teknolojisi · Türkiye · Programatik SEO</span>
    <h1>SEO Rakip Analizi: etutai.com.tr</h1>
    <p class="lead">EtütAI, LGS ve YKS (TYT/AYT) ile 5–12. sınıf öğrencilerine yönelik yapay zekâ destekli ders çalışma ürününün web ayağı. Aşağıdaki bulgular; 90 URL'lik sitemap taraması, tam sayfa teknik denetimi, SpyFu ve Similarweb görünürlük kontrolleri ile Google Trends talep verilerine dayanmaktadır.</p>
    <div class="kpi-row">
      <div class="kpi"><div class="n">90</div><div class="l">Sitemap'teki URL sayısı (tümü 18 Ağu 2026 tarihli, tek toplu yayınlama)</div></div>
      <div class="kpi"><div class="n">79</div><div class="l">Programatik test açılış sayfası (ana SEO hedefi)</div></div>
      <div class="kpi"><div class="n">0</div><div class="l">Üçüncü taraf veritabanlarında ölçülen organik anahtar kelime</div></div>
      <div class="kpi"><div class="n">100</div><div class="l">Haziran 2026 sınav haftasında LGS arama talebi endeksi (tepe)</div></div>
      <div class="kpi"><div class="n">96%</div><div class="l">Yayınlanan anahtar kelimelerin markasız (non-branded) payı</div></div>
    </div>
  </div>
</header>

<nav class="sticky-nav" aria-label="Bölümler">
  <div class="container">
    <a href="#ozet">Özet</a>
    <a href="#talep">Talep Mevsimselliği</a>
    <a href="#kapak">Kapsam Matrisi</a>
    <a href="#sayfa-tipi">Sayfa Tipi</a>
    <a href="#marka">Marka / Markasız</a>
    <a href="#teknik">Teknik Altyapı</a>
    <a href="#backlink">Backlink Kanıtı</a>
    <a href="#strateji">Stratejik Değerlendirme</a>
    <a href="#kaynaklar">Kaynaklar</a>
  </div>
</nav>

<main>

<!-- ÖZET -->
<section id="ozet">
  <div class="container">
    <h2 class="sec-title">1 · Yönetici Özeti</h2>
    <p class="finding"><b>EtütAI, henüz hiçbir üçüncü taraf veritabanında ölçülebilen organik görünürlüğü bulunmayan, ancak 90 sayfalık şablonlanmış ve şema zengini programatik SEO altyapısını tamamen yayına almış yeni bir Türk eğitim-teknoloji alan adıdır.</b></p>
    <p>SpyFu, 20 yıllık penceresinde sıfır organik anahtar kelime ve sıfır reklam harcaması raporluyor; Similarweb'in ölçüm panelinde alan adı yok. Buna karşılık kamu taraması, tüm test sayfalarının aynı başlık şablonunu, canonical etiketlerini ve FAQPage + BreadcrumbList JSON-LD bloklarını taşıdığını doğruluyor. Rakipler için izlenen varlık, olgun bir trafik motoru değil, <b>hazır bir şablon üretim hattıdır</b>: her yeni sayfa aynı şablonla dakikalar içinde üretilebilir.</p>
    <p>İş modeli bir yapay zekâ çalışma asistanı (PDF/fotoğraf yükle → açıklama ve test üret). SEO katmanı neredeyse tamamen <b>ücretsiz test açılış sayfaları</b> biçiminde kurulmuş: "9. sınıf matematik testi", "LGS matematik testleri" gibi yüksek hacimli Türk sınav hazırlık aramalarını hedefliyor. Sitenin bağımlılıkları son derece yoğun: tek pazar (Türkiye), tek dil, tek sorgu ailesi, görünür backlink stratejisi yok, blog/konu anlatımı içerikleri yok.</p>
  </div>
</section>

<!-- TALEP -->
<section id="talep" class="alt">
  <div class="container">
    <h2 class="sec-title">2 · Pazar Talebi ve Mevsimsellik</h2>
    <p class="finding"><b>EtütAI sayfalarının hasat etmeye çalıştığı arama talebi, Türk akademik takvimini izliyor: talep Eylül–Nisan arası istikrarlı düşük-orta seviyede, Haziran'da sınav haftalarında ani zirve yapıyor.</b></p>
    <div class="chart-grid">
      <div class="card" style="grid-column:1/-1">
        <h4>Türkiye'de LGS / TYT / AYT arama ilgisi — son 12 ay (göreli endeks, tepe = 100)</h4>
        <div class="chart-wrap"><canvas id="trendsChart"></canvas></div>
        <p style="font-size:12.5px;color:var(--ink2);margin-top:10px">Kaynak: Google Trends, geo=TR, "Google Web Arama", 17 Ağu 2025 – 16 Ağu 2026. Göreli endeks; mutlak hacim değildir. Sarı bant LGS sınav dönemini (Haziran), mavi bant sonuç/tercih dönemini (Tem–Ağu) gösterir.</p>
      </div>
    </div>
    <div class="note"><b>Neden bu mevsimsellik önemli:</b> 18 Ağustos 2026 tarihli bu tek toplu yayınlama, sitenin eylül ayındaki okul başlangıcı arama döngüsünü yakalamasına olanak tanır. Talep Haziran'da tepe yapar (LGS haftası 100, TYT haftası 64); Temmuz başında sonuç arama dalgası (~75) ve Ağustos başında tercih dalgası (~45) gelir. EtütAI'nin ilerideki trafik büyümesi bu dalga biçiminde ortaya çıkar.</p>
  </div>
</section>

<!-- KAPSAM -->
<section id="kapak">
  <div class="container">
    <h2 class="sec-title">3 · Yayınlanan Kapsam: Sınav/Seviye × Ders Matrisi</h2>
    <p class="finding"><b>79 test sayfasının dağılımı, kapsamın nerede yoğunlaştığını ve nerede boşluk bulunduğunu gösteriyor: en yoğun hücreler 12. Sınıf matematik, 9. Sınıf biyoloji ve LGS matematik.</b></p>
    <div class="card">
      <h4>Etkileşimli matris — hücrelerin üzerine gelin</h4>
      <div id="heatmap" class="hm"></div>
      <p style="font-size:12.5px;color:var(--ink2);margin-top:8px">Not: "Sosyal" sütunu sosyal bilgiler/bilgiler içeriklerini toplar. Boş hücreler yayınlamamış kapsam boşluğudur (örn. 10–12. sınıfta Türkçe, 5–8. sınıfta fen bilimleri konu testleri).</p>
    </div>
    <div class="limit"><b>Veri kısıtı:</b> SpyFu ve Similarweb'de ölçülen sıfır görünürlük nedeniyle bu matris "yayınlanan sayfa" matrisidir; gerçekte sıralanan/klik alan sayfa matrisi henüz üçüncü taraf verilerle doğrulanamıyor.</div>
  </div>
</section>

<!-- SAYFA TİPİ -->
<section id="sayfa-tipi" class="alt">
  <div class="container">
    <h2 class="sec-title">4 · Sayfa Tipi Analizi: Talep Nereye İner</h2>
    <p class="finding"><b>Organik ayak izinin tek baskın sayfa tipi şablonlanmış test açılış sayfalarıdır: 64 sınıf/sınav seviyesi sayfası + 15 konu mikro sayfası — klasik bir programatik SEO hamlesi.</b></p>
    <div class="chart-grid">
      <div class="card">
        <h4>Sayfa tipi dağılımı (sitemap, 90 URL)</h4>
        <div class="chart-wrap"><canvas id="pageTypeChart"></canvas></div>
      </div>
      <div class="card">
        <h4>Yayınlanan anahtar kelime segmentleri (adet)</h4>
        <div class="chart-wrap"><canvas id="brandChart"></canvas></div>
      </div>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Sayfa tipi</th><th>Adet</th><th>Kanıt</th><th>Yorum</th></tr></thead>
        <tbody>
          <tr><td>Ana sayfa / marka</td><td class="num">1</td><td>/ — marka adı başlık, WebSite + WebApplication şeması</td><td>440 kelimelik ince marka merkezi; başlık yalnızca "EtütAI"</td></tr>
          <tr><td>Sınav/okul hub'ları</td><td class="num">7</td><td>/testler, /siniflar, /lise, /ortaokul, /lgs, /tyt, /ayt</td><td>Kategori hub'ları; /tyt yalnızca 92 kelime ve H2'siz — ince</td></tr>
          <tr><td>Sınıf/sınav test sayfaları</td><td class="num">64</td><td>{sinif/sınav}-{ders}-test şablonu</td><td>Çekirdek SEO hedef kümesi</td></tr>
          <tr><td>Konu mikro test sayfaları</td><td class="num">15</td><td>{sinif}-{ders}-{konu}-test (hücre, türev, integral…)</td><td>Uzun kuyruk uzantı katmanı</td></tr>
          <tr><td>Yasal sayfalar</td><td class="num">3</td><td>.php uzantılı, meta description yok</td><td>İçerik değil; eski altyapı sinyali</td></tr>
        </tbody>
      </table>
    </div>
    <p style="font-size:14px;color:var(--ink2)">Ortalama test sayfası yalnızca ~131 kelime içeriyor. Bu sayfalar içerik derinliğinden değil, şablon tutarlılığı ve şema işaretlemesinden (FAQPage, BreadcrumbList) güç alıyor. Ana sayfa meta açıklamaları "yapay zekâ konu anlatımı" vaat etse de sitemap'te tek bir konu anlatımı/blog sayfası bulunmuyor — içerik stratejisi tamamen test açılış sayfası odaklı.</p>
  </div>
</section>

<!-- MARKA -->
<section id="marka">
  <div class="container">
    <h2 class="sec-title">5 · Marka / Markasız Arama Yapısı</h2>
    <p class="finding"><b>Yayınlanan anahtar kelime kümesinin %96'sı markasız (79 markasız hedefe karşı 3 markalı: "etütai", "etut ai", "etutai.com.tr").</b></p>
    <div class="chart-grid">
      <div class="card">
        <h4>Marka × markasız deployed keywords (adet)</h4>
        <div class="chart-wrap"><canvas id="brandSplitChart"></canvas></div>
      </div>
      <div class="card">
        <h4>Hedeflenen markasız sorgu aileleri (örnekleme)</h4>
        <div class="chart-wrap"><canvas id="queryFamilyChart"></canvas></div>
      </div>
    </div>
    <div class="limit"><b>Veri kısıtı:</b> Üçüncü taraf veritabanlarında ölçülen trafik sıfır olduğundan, <i>tıklama ağırlığı</i> hesaplanamıyor; yalnızca yayınlanan kelime adedi üzerinden konuşulabiliyor. Bu yapı stratejik olarak net bir hikâye anlatıyor: marka dönüş trafiğine değil, genel sınav hazırlık sorgularından keşfe yatırım yapılıyor ve mevcut marka talebi fiilen sıfır seviyesinde.</div>
  </div>
</section>

<!-- TEKNİK -->
<section id="teknik" class="alt">
  <div class="container">
    <h2 class="sec-title">6 · Teknik ve Sayfa Üzeri Altyapı</h2>
    <p class="finding"><b>Tüm test sayfaları özdeş şablonla kurulmuş: "{Sınıf/Sınav} {Ders} Testleri | EtütAI" başlık kalıbı, canonical etiketleri (79/79), meta açıklama (77/79), FAQPage ve BreadcrumbList JSON-LD.</b></p>
    <div class="chart-grid">
      <div class="card">
        <h4>Sayfa üstü elementlerin kapsama oranı (79 test sayfası)</h4>
        <div class="chart-wrap"><canvas id="onpageChart"></canvas></div>
      </div>
      <div class="card">
        <h4>robots.txt içerik sinyal politikası</h4>
        <div style="font-size:14px;line-height:2">
          <span class="tag green">search = yes</span>&nbsp; arama motoru dizinine katılım<br>
          <span class="tag red">ai-train = no</span>&nbsp; AI eğitimine içerik sağlanmıyor<br>
          <span class="tag blue">use = reference</span>&nbsp; referans kullanımı<br>
          <span class="tag amber">Bloklanan botlar</span>&nbsp; GPTBot, ClaudeBot, Amazonbot, Applebot-Extended, Bytespider, CCBot
        </div>
        <p style="font-size:12.5px;color:var(--ink2);margin-top:10px">Google ve Bing'e izin veriliyor — klasik arama bu alan adının planlanmış birincil edinim kanalıdır.</p>
      </div>
    </div>
    <p style="font-size:14px;color:var(--ink2)">URL mimarisi düzdür (klasörsüz, 81 test sayfası kök düzeyde); iç bağlantı sayısı sayfa başına ~4 (3 ilgili-test önerisi + footer). BreadcrumbList JSON-LD, düz URL yapısının fiilen barındırmadığı mantıksal bir hiyerarşi gösteriyor (Anasayfa &gt; Testler &gt; LGS &gt; sayfa).</p>
  </div>
</section>

<!-- BACKLINK -->
<section id="backlink">
  <div class="container">
    <h2 class="sec-title">7 · Backlink Stratejisi Kanıtı</h2>
    <p class="finding"><b>etutai.com.tr için kamuya açık hiçbir anlamlı backlink profili görünmüyor; erişilebilir veritabanlarında ölçülebilir bağlantı ayak izi yok.</b></p>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Soru</th><th>Ulaşılabilen kanıt</th><th>Sonuç</th></tr></thead>
        <tbody>
          <tr><td>Toplam backlink / referans alan</td><td>Ahrefs ücretsiz kontrolleri bu ortamdan erişime kapalı; SpyFu/Similarweb sıfır görünürlük</td><td class="num">Ölçülemez; görünür olarak yok</td></tr>
          <tr><td>Anchor metin karışımı</td><td>Backlink verisi yok</td><td class="num">Grafik üretilemez — kısıt olarak belgelenmiştir</td></tr>
          <tr><td>Hedef sayfa tipi karışımı</td><td>Backlink verisi yok</td><td class="num">Grafik üretilemez — kısıt olarak belgelenmiştir</td></tr>
          <tr><td>Bağlantı stratejisi deseni</td><td>Yeni yayınlama; görünür PR/dizin ayak izi yok</td><td class="num">Henüz desen yok</td></tr>
        </tbody>
      </table>
    </div>
    <p style="font-size:14px;color:var(--ink2)">Ahrefs'in ücretsiz DR API'si ve Website Authority Checker'ı bu ortamdan doğrulanamıyor; Comparative taramalar da aynı engelle karşılaştı. Tüm sitemap URL'lerinin aynı son değiştirme tarihiyle birlikte değerlendirildiğinde en savunulabilir karakterizasyon: alan adı DR ~0 seviyesinde, Ağustos 2026'da başlayan yeni bir yayınlama.</p>
  </div>
</section>

<!-- STRATEJİ -->
<section id="strateji" class="alt">
  <div class="container">
    <h2 class="sec-title">8 · Stratejik Değerlendirme: Bağımlılıklar ve Kırılganlıklar</h2>
    <p class="finding"><b>EtütAI'nin SEO konumu tek bir bağımlılık zincirine dayanıyor: tek programatik şablon, tek pazar, tek sorgu ailesi — görünür otorite, marka talebi ve alternatif kanal yok.</b></p>
    <div class="chart-grid">
      <div class="card" style="grid-column:1/-1">
        <h4>Gözlemlenen bağımlılık / kırılganlık haritası</h4>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>Bağımlılık</th><th>Ağırlık</th><th>Gözlenen kırılganlık</th></tr></thead>
            <tbody>
              <tr><td>Programatik test şablonu</td><td><span class="tag red">Çok yüksek</span></td><td>79/90 URL'nin tamamı bu tek şablona bağlı; ~131 kelimelik ince içerik, yerleşik rakiplere (sanalokulumuz, testlericoz, eokultv, testkolik, testcoz.online) karşı şablon tutarlılığı ve FAQ şeması dışındaki hiçbir derinliğe sahip değil</td></tr>
              <tr><td>Tek pazar (Türkiye, TR dil)</td><td><span class="tag red">Çok yüksek</span></td><td>Hiçbir coğrafi veya dil çeşitlendirmesi yok; ülke düzeyinde bölünmüş trafik tablosu üretilemiyor — belgelenen veri kısıtı</td></tr>
              <tr><td>Genel sınav sorguları</td><td><span class="tag red">Çok yüksek</span></td><td>%96 markasız; marka dönüş trafiğine dayanamıyor; talep Haziran'da tepe yapan keskin mevsimsellik taşıyor</td></tr>
              <tr><td>Dizin/bağlantı otoritesi</td><td><span class="tag amber">Yüksek</span></td><td>Hiçbir görünür backlink stratejisi; hub sayfaları ince (/tyt: 92 kelime, H2 yok); sayfa arası iç bağlantı minimal</td></tr>
              <tr><td>Blog/konu anlatımı katmanı</td><td><span class="tag amber">Yüksek</span></td><td>Meta açıklamalarda vaat edilen "yapay zekâ konu anlatımı" sitemap'te yok — içerik stratejisi yalnızca test sayfalarıyla sınırlı</td></tr>
            </tbody>
          </table>
        </div>
        <div class="note"><b>Rakipler için izlenecek gözlemlenebilir sorular:</b> Şablon sayfaları Türk SERP'lerinde yayınlanan anahtar kelime kümesi için belirmeye başlıyor mu? Ağustos 2026 yayınlaması üçüncü taraf görünürlük biriktirmeye başlıyor mu? Bağlantı edinimi, meta anahtar kelimelerin işaret ettiği blog/konu anlatımı genişlemesi veya AI-overview katılım stratejileri gibi bir sonraki gözlemlenebilir hamlelerden hangisi gerçekleşiyor? Bu hamlelerin her biri rekabet tehdidi düzeyini maddi olarak değiştirir.</div>
      </div>
    </div>
  </div>
</section>

<!-- KAYNAKLAR -->
<section id="kaynaklar">
  <div class="container">
    <h2 class="sec-title">9 · Kaynaklar ve Metodoloji</h2>
    <p style="font-size:14px;color:var(--ink2);max-width:820px">Bu analiz yalnızca halka açık kanıtlara dayanmaktadır: sitemap/robots.txt taraması, 90 URL'lik tam sayfa üstü denetim, SpyFu alan adı görünümü, Similarweb erişilebilirlik kontrolü ve Google Trends (TR, son 12 ay). Üçüncü taraf metrikler yönlendirici veridir; ilk taraf analitik verisi değildir. Trafik trendi, ülke görünürlüğü ve backlink grafikleri ölçülen veri bulunmadığı için kasıtlı olarak üretilmemiştir — bunlar rapor içinde veri kısıtı olarak belgelenmiştir.</p>
    <div class="srcs">
      <div class="card">
        <h5>Veri kaynakları</h5>
        <ol>
          <li>Kamu taraması: ana sayfa, robots.txt, sitemap, 90 URL tam sayfa denetimi (18 Ağu 2026)</li>
          <li>sitemap_urls_classified.csv — sınıflandırılmış sitemap envanteri</li>
          <li>test_page_inventory.csv — sınav/seviye × ders × konu envanteri</li>
          <li>keyword_sample.csv — URL mimarisinden türetilen 82 anahtar kelimelik küme</li>
          <li>SpyFu alan adı görünümü: 0 organik anahtar kelime (18 Ağu 2026)</li>
          <li>Similarweb: etutai.com.tr için ölçüm paneli verisi yok</li>
          <li>Google Trends TR: LGS/TYT/AYT, son 12 ay (göreli endeks)</li>
        </ol>
      </div>
      <div class="card">
        <h5>Üretilen analiz dosyaları</h5>
        <ol>
          <li>page_type_summary.csv — sayfa tipi dağılımı</li>
          <li>branded_nonbranded.csv — marka/markasız segment özetleri</li>
          <li>top_pages.csv — 79 test sayfası envanteri</li>
          <li>trends_12m.csv — normalleştirilmiş Trends serisi</li>
          <li>chart asset manifest + 5 grafik dosyası</li>
        </ol>
      </div>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="container">
    <h5>SEO Rakip Analizi Raporu — etutai.com.tr</h5>
    <p>Manus AI tarafından hazırlanmıştır · 18 Ağustos 2026 · Rekabet istihbaratı amaçlıdır; hedef alan adına yönelik tavsiye içermez.</p>
  </div>
</footer>

<script>
/* ============ CHART.JS SETUP ============ */
Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
Chart.defaults.color = '#475569';
Chart.defaults.plugins.legend.labels.boxWidth = 12;

const BLUE='#2563eb', ORANGE='#ea580c', GREEN='#16a34a', RED='#dc2626', AMBER='#f59e0b', CYAN='#0891b2', PURPLE='#7c3aed';

/* 1) Trends seasonality */
new Chart(document.getElementById('trendsChart'), {
  type:'line',
  data:{
    labels:['Ağu 25','Eyl 25','Eki 25','Kas 25','Ara 25','Oca 26','Şub 26','Mar 26','Nis 26','May 26','Haz 26','Tem 26','Ağu 26'],
    datasets:[
      {label:'LGS',data:[5,6,6,6,6,6,8,10,12,14,77,37,20],borderColor:BLUE,backgroundColor:'rgba(37,99,235,.08)',fill:true,tension:.35,borderWidth:2.4},
      {label:'TYT',data:[12,17,16,14,14,13,14,12,12,13,42,15,10],borderColor:ORANGE,tension:.35,borderWidth:2.4},
      {label:'AYT',data:[4,6,6,6,6,6,8,8,10,11,24,7,4],borderColor:GREEN,tension:.35,borderWidth:2.4}
    ]
  },
  options:{
    responsive:true,maintainAspectRatio:false,
    plugins:{
      legend:{position:'top'},
      tooltip:{
        callbacks:{afterBody:ctx=>{
          const notes=['Ağu: sınav hazırlığı başlangıcı','Eyl: okul başlangıcı','Haz: sınav haftaları (tepe)','Tem: sonuçlar','Ağu: tercih dönemi'];
          return notes[ctx[0].dataIndex]||'';
        }}
      },
      annotation:{}
    },
    scales:{y:{beginAtZero:true,title:{display:true,text:'Göreli ilgi endeksi (tepe = 100)'}},x:{grid:{display:false}}}
  }
});

/* 2) Page type distribution */
new Chart(document.getElementById('pageTypeChart'),{
  type:'doughnut',
  data:{
    labels:['Sınıf/sınav test sayfaları (64)','Konu mikro test sayfaları (15)','Hub sayfaları (7)','Yasal sayfalar (3)','Ana sayfa (1)'],
    datasets:[{data:[64,15,7,3,1],backgroundColor:[BLUE,CYAN,PURPLE,AMBER,'#94a3b8'],borderWidth:0}]
  },
  options:{
    responsive:true,maintainAspectRatio:false,cutout:'55%',
    plugins:{legend:{position:'bottom',labels:{font:{size:12}}}}
  }
});

/* 3) Branded vs non-branded (counts) */
new Chart(document.getElementById('brandChart'),{
  type:'bar',
  data:{labels:['Markalı','Markasız'],datasets:[{label:'Yayınlanan anahtar kelime adedi',data:[3,79],backgroundColor:['#94a3b8',BLUE],borderRadius:8,barThickness:56}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{afterBody:()=>'%96 markasız, %4 markalı (adet üzerinden)'}}},scales:{y:{beginAtZero:true,title:{display:true,text:'Anahtar kelime adedi'}},x:{grid:{display:false}}}}
});

/* 4) Brand split horizontal */
new Chart(document.getElementById('brandSplitChart'),{
  type:'bar',
  data:{labels:['Markasız','Markalı'],datasets:[{data:[79,3],backgroundColor:[BLUE,'#94a3b8'],borderRadius:8,barThickness:44}]},
  options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,title:{display:true,text:'Yayınlanan anahtar kelime adedi'}},y:{grid:{display:false}}}}
});

/* 5) Query family sample */
new Chart(document.getElementById('queryFamilyChart'),{
  type:'bar',
  data:{
    labels:['Sınıf + ders testleri (örn. "9. sınıf matematik testleri")','LGS alt testleri','TYT/AYT alt testleri','Konu spesifik testleri (örn. türev, hücre)'],
    datasets:[{data:[38,13,12,16],backgroundColor:[BLUE,CYAN,ORANGE,GREEN],borderRadius:8,barThickness:30}]
  },
  options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{afterBody:ctx=>'Bu segmentin yayınlanan sayfa sayısıdır; ölçülen trafik verisi mevcut değildir.'}}},scales:{x:{beginAtZero:true,title:{display:true,text:'Yayınlanan sayfa adedi'}},y:{grid:{display:false},ticks:{font:{size:11}}}}}
});

/* 6) On-page element coverage */
new Chart(document.getElementById('onpageChart'),{
  type:'bar',
  data:{
    labels:['Canonical etiket','Meta description','BreadcrumbList JSON-LD','FAQPage JSON-LD','Title şablonu'],
    datasets:[{label:'Kapsanan sayfa (79 üzerinden)',data:[79,77,77,77,79],backgroundColor:[GREEN,GREEN,CYAN,CYAN,BLUE],borderRadius:8,barThickness:30}]
  },
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,max:79,title:{display:true,text:'Sayfa sayısı'}},x:{grid:{display:false}}}}
});

/* ============ INTERACTIVE HEATMAP ============ */
const hmData=[
  // exam, subjects in order: Mat, Türkçe, Fizik, Kimya, Biyo, Sosyal
  ['5. Sınıf',[1,1,0,0,0,1]],['6. Sınıf',[1,1,0,0,0,1]],['7. Sınıf',[1,1,0,0,0,1]],['8. Sınıf',[2,1,0,0,0,0]],
  ['9. Sınıf',[2,0,2,1,3,0]],['10. Sınıf',[1,0,1,2,1,0]],['11. Sınıf',[2,0,1,1,1,0]],['12. Sınıf',[3,0,1,1,1,0]],
  ['LGS',[3,2,0,0,0,0]],['TYT',[2,1,0,0,0,1]],['AYT',[2,0,1,1,1,0]]
];
const subjs=['Matematik','Türkçe','Fizik','Kimya','Biyoloji','Sosyal'];
const hm=document.getElementById('heatmap');
hm.style.gridTemplateColumns=`110px repeat(6,1fr)`;

/* header row */
['Sınav/Seviye',...subjs].forEach(h=>{
  const d=document.createElement('div');
  d.style.cssText='font-size:12px;font-weight:700;color:var(--ink2);display:flex;align-items:center;justify-content:center;padding:4px';
  d.textContent=h;hm.appendChild(d);
});
hmData.forEach(([exam,vals])=>{
  const lab=document.createElement('div');
  lab.style.cssText='font-size:12.5px;font-weight:700;color:var(--ink);display:flex;align-items:center;padding-left:8px';
  lab.textContent=exam;hm.appendChild(lab);
  vals.forEach((v,i)=>{
    const c=document.createElement('div');
    c.className='cell'+(v===0?' zero':'');
    if(v>0){
      const t=v/3;
      c.style.background=`rgba(37,99,235,${0.25+t*0.75})`;
    }
    c.textContent=v;
    const tt=document.createElement('span');tt.className='tt';
    tt.textContent=v===0?`${exam} — ${subjs[i]}: yayınlamamış (boşluk)`:`${exam} ${subjs[i]}: ${v} test sayfası yayınlandı`;
    c.appendChild(tt);hm.appendChild(c);
  });
});
</script>
</body>
</html>
